datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS (PERFIS, STATUS E CONTROLES)
// ==========================================

enum Role {
  ALUNO
  BIBLIOTECARIO
  ADMIN
}

enum StatusUsuario {
  ATIVO
  INATIVO
}

enum StatusTicket {
  PENDENTE
  EM_REVISAO
  EM_CORRECAO
  AJUSTES_NECESSARIOS
  APROVADO
  FECHADO
}

// ==========================================
// 2. MODELOS DE TABELAS
// ==========================================

model Usuario {
  id        Int           @id @default(autoincrement())
  nome      String
  email     String        @unique
  senha     String
  matricula String        @unique
  telefone  String?
  curso     String?
  role      Role          @default(ALUNO)
  status    StatusUsuario @default(ATIVO)
  createdAt DateTime      @default(now())

  ticketsComoAluno        Ticket[] @relation("TicketsDoAluno")
  ticketsComoBibliotecario Ticket[] @relation("TicketsDoBibliotecario")

  @@map("usuarios")
}

model Ticket {
  id                       Int          @id @default(autoincrement())
  titulo                   String
  descricao                String?      @db.Text
  tema                     String?
  curso                    String?
  aluno                    String
  status                   StatusTicket @default(PENDENTE)
  versao                   Int          @default(1)
  bibliotecarioResponsavel String?
  dataAtribuicao           DateTime?
  createdAt                DateTime     @default(now())
  
  alunoId                  Int?
  bibliotecarioId          Int?

  alunoRel                 Usuario?     @relation("TicketsDoAluno", fields: [alunoId], references: [id], onDelete: SetNull)
  bibliotecarioRel         Usuario?     @relation("TicketsDoBibliotecario", fields: [bibliotecarioId], references: [id], onDelete: SetNull)
  
  feedbacks                Feedback[]
  historico                HistoricoStatus[]
  historicoArquivos        HistoricoTicket[]

  @@map("tickets")
}

model Feedback {
  id            Int      @id @default(autoincrement())
  ticketId      Int
  bibliotecario String
  comentario    String   @db.Text
  createdAt     DateTime @default(now())

  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model HistoricoStatus {
  id        Int          @id @default(autoincrement())
  ticketId  Int
  status    StatusTicket
  data      DateTime     @default(now())

  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("historico_status")
}

model HistoricoTicket {
  id          Int      @id @default(autoincrement())
  versao      Int
  nomeArquivo String
  observacoes String?  @db.Text
  ticketId    Int
  createdAt   DateTime @default(now())

  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("historico_tickets")
}

model ProdutividadeBibliotecario {
  id                Int      @id @default(autoincrement())
  bibliotecarioNome String
  concluidas        Int      @default(0)
  emAndamento       Int      @default(0)
  tempoMedioDias    Float    @default(0.0)
  createdAt         DateTime @default(now())

  @@map("produtividade_analytics")
}